# ~/.zshrc managed by setup-zsh

export ZSH="${ZSH:-$HOME/.oh-my-zsh}"

ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins managed via plugins/plugins.txt (setup.sh clones them)
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# Local overrides (not committed)
[[ -f "$HOME/.zsh/local.zsh" ]] && source "$HOME/.zsh/local.zsh"

# Editor/locale defaults
export EDITOR="${EDITOR:-vim}"
export LANG="${LANG:-en_US.UTF-8}"

# Use modern completion system
autoload -Uz compinit
compinit

# powerlevel10k config (generated by `p10k configure` on first launch)
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
